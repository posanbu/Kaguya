{
  "name": "kaguya",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": "24.18.0",
    "pnpm": "11.9.0"
  },
  "scripts": {
    "build": "tsc -b && pnpm --filter @kaguya/web build",
    "dev": "pnpm --filter @kaguya/server dev",
    "start": "pnpm --filter @kaguya/server start",
    "typecheck": "tsc -b --pretty false && pnpm --filter @kaguya/web typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "prompt:test": "cross-env PROMPTFOO_DISABLE_TELEMETRY=1 PROMPTFOO_DISABLE_UPDATE=1 HTTPS_PROXY=http://127.0.0.1:9 HTTP_PROXY=http://127.0.0.1:9 ALL_PROXY=http://127.0.0.1:9 NO_PROXY= https_proxy=http://127.0.0.1:9 http_proxy=http://127.0.0.1:9 all_proxy=http://127.0.0.1:9 no_proxy= promptfoo eval --no-cache",
    "demo": "pnpm --filter @kaguya/demo start"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "cross-env": "10.1.0",
    "eslint": "10.7.0",
    "prettier": "3.9.6",
    "promptfoo": "0.121.19",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10"
  }
}

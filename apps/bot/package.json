    "@kaguya/llm": "workspace:*",
    "@kaguya/logger": "workspace:*",
    "@kaguya/platform-adapters": "workspace:*",
    "@kaguya/prompt": "workspace:*",
    "@kaguya/sdk": "workspace:*"
  }
}
